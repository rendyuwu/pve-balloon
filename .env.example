# Copy to .env and fill in. `.env` is gitignored; keep it chmod 600.
# Anything already exported in your shell wins over what is written here.

# One node, not a cluster name. A cluster has no single address unless you put a
# VIP or reverse proxy in front of it. Whichever node you name forwards the query
# to the node that owns each VM, so one entry point answers for the whole cluster.
# Port defaults to 8006 when you leave it off; write it when yours differs.
#   pve1
#   pve1.internal:443
#   https://pve.example.com:443
PVE_HOST=pve1.example.com

# API token: user@realm!tokenid=secret
# Create a read-only one (see README, "Token"), not root@pam.
PVE_TOKEN=monitor@pve!ro=00000000-0000-0000-0000-000000000000

# Set to 1 for the self-signed certificate a stock PVE node serves. Prefer leaving
# this unset and pointing SSL_CERT_FILE at your cluster CA instead.
#PVE_INSECURE=1
